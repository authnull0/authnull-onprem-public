# =============================================================================
#  CUSTOMER: fill ONLY these, then run the stack. Everything else is preset.
# =============================================================================
#   1. DB user      -> DB_USER  and  POSTGRES_USER   (must be identical)
#   2. DB password  -> DB_PASSWORD and POSTGRES_PASSWORD (must be identical)
#   3. Reachable URL-> SYSTEM_URL (http://<your-vm-ip>) and SYSTEM_IP (<your-vm-ip>)
#
#  These are the credentials for the bundled PostgreSQL that the stack creates
#  and connects to. Pick any user/password; the four DB_/POSTGRES_ fields must
#  match as noted. SYSTEM_URL is how browsers/agents/wallet reach this VM
#  (plain http, no domain, no trailing slash) and SYSTEM_IP is the same IP alone.
# =============================================================================

# ======================
# DATABASE   (<-- CUSTOMER: set DB_USER / DB_PASSWORD, keep the rest)
# ======================
DB_HOST=postgres
DB_PORT=5432
DB_USER=ram
DB_PASSWORD=test123
DB_NAME=ram_db
DB_SCHEMA=did

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ram_db
POSTGRES_USER=ram
POSTGRES_PASSWORD=test123

# ======================
# ONPREM UI CONFIG   (<-- CUSTOMER: set SYSTEM_URL and SYSTEM_IP, keep the rest)
# ======================
TENANT_ID=1
ORG_NAME=beta
DOMAIN_URL=default.beta.prod.authnull.com
SYSTEM_URL=https://onprem.prod.authnull.com
SYSTEM_IP=172.174.243.161

# Where the admin UI sends an unauthenticated user to sign in. The UI does
# window.location.href = "${SSC_SIGNIN_URL}?domainUrl=...", so when this is empty
# it navigates to "?domainUrl=..." on itself and /tenant/login reloads forever.
SSC_SIGNIN_URL=https://onprem.prod.authnull.com/ssc/signin
# Base the backend prepends "/ssc/signin" to after a SAML login (default: SaaS host).
SSC_BASE_URL=https://onprem.prod.authnull.com
# Admin UI root for emailed links and the post-verify redirect (/org/verify-email).
CLIENT_URL=https://onprem.prod.authnull.com
# Tenant sites are default.<org>.${TENANT_BASE_DOMAIN}; must match nginx/DNS.
TENANT_BASE_DOMAIN=prod.authnull.com

# =============================================================================
#  PRESET BY AUTHNULL — do not change unless instructed
# =============================================================================

# ======================
# REDIS
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=PrA6zPWF7b
REDIS_DB=0

# ======================
# SMTP (AuthNull shared relay — sends verification / wallet emails)
# ======================
SMTP_HOST=smtp.elasticemail.com
SMTP_PORT=2525
SMTP_FROM=support@authnull.com
SMTP_PASSWORD=E2AA24DAB22D3996F76B2DCA9F2BFCEDD478

# ======================
# ENCRYPTION KEYS
# ======================
# Both encrypt data at rest. Do NOT change once the stack has run: changing a key
# does not fail loudly -- it silently makes existing data unreadable (and the TOTP
# key locks every user out of MFA). Keep a backup of this file.
# ENCRYPTION_KEY:      32 hex chars  (openssl rand -hex 16)
# TOTP_ENCRYPTION_KEY: 64 hex chars  (openssl rand -hex 32)
ENCRYPTION_KEY=52747ba323dfeccb203fbde2ce6f88e4
TOTP_ENCRYPTION_KEY=99ead1f5ff479047de583d79bb6873bd1c08c7593a7ccbaa11f5c9b0c5d531da

# ======================
# HOST PORT OVERRIDES
# ======================
# 9090 is used by cockpit on many RHEL/Debian installs -- change if it collides.
PAM_HOST_PORT=9090

COMPOSE_PROJECT_NAME=onprem

# =============================================================================
# OKTA SSO (OPTIONAL) — only if you run:  docker compose --profile okta up -d
# Values come from YOUR Okta tenant (Applications -> SAML app -> Sign On).
# =============================================================================
OKTA_LOGIN_ROOT_URL=https://www.okta.com/exkd34w6nxTiIRwaW5d7
OKTA_LOGIN_IDP_METADATA_URL=https://dev-10065336.okta.com/app/exkd34w6nxTiIRwaW5d7/sso/saml/metadata
BLOCKCHAIN_OKTA_APP_SSO_URL=

# =============================================================================
# OPTIONAL INTEGRATIONS (leave blank to disable)
# =============================================================================
# MinIO (object storage; pam-service can use LOCAL_STORAGE_ENABLED instead)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BROWSER_REDIRECT_URL=
# AI / risk
AI_SERVICE_API_KEY=
AIPOLICY_API_KEY=
AZURE_OPENAI_API_KEY=
# Misc
LOCAL_PASSWORD=
IPINFO_TOKEN=
GIT_TOKEN=
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_AUTH_KEY=
CLOUDFLARE_AUTH_EMAIL=
# Azure blob
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Ethereum RPC for verifier-service (on-chain lookups)
ALCHEMY_API_KEY=
# Google Cloud bucket for pam-service session recordings
