# ==================
# ONPREM UI CONFIG
# ==================
TENANT_ID=1
ORG_NAME=alpha #example
# Tenant base domain -- provisioning writes tenants.site_url as
# default.<org>.<TENANT_BASE_DOMAIN>. This deployment serves *.dev.authnull.com.
# Wallet onboarding. When "false", normalLogin reports wallet_status="Registered"
# for users without a wallet, so the self-service console skips the wallet-pairing
# wizard and offers the tenant's configured factors (TOTP / Passkey) instead.
# See internal/mfa/handler/login.go for why this is needed and how to retire it.
WALLET_ONBOARDING_REQUIRED=false
TENANT_BASE_DOMAIN=dev.authnull.com #example
DOMAIN_URL=default.alpha.dev.authnull.com #example
SYSTEM_URL=https://onprem.dev.authnull.com #example
# The API root the mobile app is told to call. It travels inside every invite QR and every push
# payload (data.base_url), because one app-store binary serves the SaaS and every on-prem install
# and cannot otherwise tell them apart. appurl.API() falls back to SYSTEM_URL when this is unset,
# which is correct here but leaves the value implicit -- set it so it is stated, not inferred.
API_BASE_URL=https://onprem.dev.authnull.com #example
SYSTEM_IP=49.12.150.218 #example
# ======================
SSC_SIGNIN_URL=https://onprem.dev.authnull.com/ssc/signin
SSC_URL=https://onprem.dev.authnull.com
UI_URL=https://onprem.dev.authnull.com
ENV=production
GIN_MODE=release
LOGGING_URL=
SSO_VERIFICATION_URL=
FIX_TENANT_URL=false