# ============
# AUTH
# ============
JWT_SECRET=

# ====
# MFA
# ====
MFA_PROVIDER=
DUO_IKEY=
DUO_SKEY=
DUO_HOST=
OKTA_DOMAIN=
OKTA_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=
# AuthNull Authenticator (Flutter). Set MFA_PROVIDER=authnull to use it.
# FCM_SERVICE_ACCOUNT_JSON takes a path or the inline JSON (leading '{').
# FCM_PROJECT_ID defaults to project_id inside that credential.
# Path INSIDE the container -- see the bind mount on authnull-service in docker-compose.yml.
# The host file is ./secrets/fcm-service-account.json, which is gitignored.
FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm-service-account.json
# Left empty on purpose: it defaults to project_id in the credential ("authnull-one"), so there
# is only one place to change when the key is rotated.
FCM_PROJECT_ID=
# Ingress CIDRs. Empty = trust no proxy (client IP = socket peer, not spoofable).
TRUSTED_PROXIES=
# 60s, matching the DC sensor's mfa_timeout_seconds. Do not raise without raising the
# sensor (buildSensorConfig) and gateway (buildGatewayConfigs) timeouts too.
MFA_PUSH_CHALLENGE_TTL_SEC=60
# Response-signature enforcement. EMPTY MEANS ENFORCED, and anything unparseable also means
# enforced, so a typo fails secure. Set it to true only to debug a signing problem, never in
# production: the respond endpoints are reachable unauthenticated by design (the phone holds no
# session) and the signature is the only thing standing between a sequential challenge id and
# anyone approving another user's login.
MFA_PUSH_ALLOW_UNSIGNED=
# Email -> org lookup for the app's manual-entry path. An account-enumeration oracle, so it stays
# off unless explicitly true; when off, "disabled" and "no such address" return identical 404s.
ORG_DISCOVERY_ENABLED=
# Whole-request timeout for the inline authorization call, seconds. Empty = 5s; the measured round
# trip here is ~0.6s. Cannot be disabled: 0 or a non-number falls back to the default.
AUTHNZ_TIMEOUT_SEC=
# off | api  — see MFA_GEOIP_API_URL. Defaults to off for on-prem/air-gapped.
MFA_GEOIP_MODE=off
MFA_GEOIP_API_URL=
MFA_GEOIP_TIMEOUT_MS=300
# Enable only after the activity table has real history.
MFA_PUSH_RISK_ENABLED=false
MFA_PUSH_RISK_LOOKBACK_DAYS=30
# Set MFA_PUSH_SWEEP_ENABLED=true on ONE replica only.
MFA_PUSH_ACTIVITY_RETENTION_DAYS=90
MFA_PUSH_SWEEP_ENABLED=false
MFA_PUSH_ALERT_TO=
MFA_PUSH_ALERT_COOLDOWN_MIN=15
WEBAUTHN_RP_NAME=Authnull
# RP ID must be the origin's effective domain or a registrable suffix of it.
# "dev.authnull.com" is a suffix of BOTH onprem.dev.authnull.com and every
# default.<org>.dev.authnull.com, so one value serves the console host and all
# tenant subdomains. Changing it later invalidates every enrolled passkey.
WEBAUTHN_RP_ID=dev.authnull.com
# Every origin the console can be reached on -- the library rejects a ceremony
# whose browser origin is not listed. nginx serves /ssc/ on the deployment host
# and on each tenant host, so both are needed; add each new org's tenant host
# here if users will enrol passkeys there.
WEBAUTHN_ORIGIN=https://onprem.dev.authnull.com,https://default.beta.dev.authnull.com


